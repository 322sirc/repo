# Toit properly, word splitting has to be perbyshell, i.e. $@ or $0quotes.reive logoutnot sourced.

case $SHELL */bash|*/zsh)
    exec- -c '"$@"' - $@;;ctcc 'if (-f /etc/csh.); ~/;argv'fi[ pro] && .$HOME/.) # Plain sh, ksh, and anything we doknow.esac

exit 1X537#! Imporfor somby them as
#execut. Inside, SDDM_XPROFILE_READ will be se
# itinues below.
if [ -z "$" ]; then
  ex=1

  0  fi
unse

x


#ll  xinitrcdX11/rc.dfor i in/* ; do
  x "$i  .
  fi
  done
fi

